doctype html
html
  head
    title Phonebook
    meta(name="viewport", content="width=device-width, initial-scale=1")
    style.
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0faf4; color: #1a1a2e; min-height: 100vh; }
      header { background: #16a34a; color: #fff; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
      header h1 { font-size: 1.4rem; }
      header a { color: rgba(255,255,255,.85); text-decoration: none; font-size: 0.9rem; background: rgba(255,255,255,.15); padding: 7px 16px; border-radius: 6px; transition: .2s; }
      header a:hover { background: rgba(255,255,255,.25); }
      main { max-width: 900px; margin: 32px auto; padding: 0 20px 60px; }
      .card { background: #fff; border-radius: 12px; box-shadow: 0 2px 10px rgba(0,0,0,.07); padding: 28px 32px; margin-bottom: 24px; }
      h1, h2 { color: #15803d; margin-bottom: 20px; }
      label { display: block; font-size: 0.85rem; font-weight: 600; color: #555; margin-bottom: 5px; }
      input[type="text"], textarea {
        width: 100%; padding: 9px 13px; border: 1px solid #d1fae5; border-radius: 7px;
        font-size: 0.95rem; outline: none; transition: border .2s; margin-bottom: 14px;
        font-family: inherit;
      }
      input:focus, textarea:focus { border-color: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,.12); }
      textarea { min-height: 80px; resize: vertical; }
      .btn { display: inline-block; padding: 9px 20px; border: none; border-radius: 7px; cursor: pointer; font-size: 0.9rem; font-weight: 600; transition: all .2s; text-decoration: none; }
      .btn-primary { background: #16a34a; color: #fff; }
      .btn-primary:hover { background: #15803d; }
      .btn-edit { background: #2563eb; color: #fff; padding: 5px 12px; font-size: 0.82rem; border-radius: 5px; }
      .btn-edit:hover { background: #1d4ed8; }
      .btn-delete { background: #dc2626; color: #fff; padding: 5px 12px; font-size: 0.82rem; border-radius: 5px; }
      .btn-delete:hover { background: #b91c1c; }
      table { width: 100%; border-collapse: collapse; font-size: 0.93rem; }
      th { background: #f0fdf4; color: #15803d; padding: 10px 14px; text-align: left; font-weight: 600; border-bottom: 2px solid #d1fae5; }
      td { padding: 10px 14px; border-bottom: 1px solid #f0fdf4; vertical-align: middle; }
      tr:hover td { background: #f7fef9; }
      .empty-state { text-align: center; padding: 40px; color: #9ca3af; }
  body
    header
      h1 📱 Phonebook
      a(href="/add") + Add Contact
    main
      block content
