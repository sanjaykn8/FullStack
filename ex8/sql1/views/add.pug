extends layout
block content
  .card
    h2 Add New Contact
    form(method="POST")
      label Name
      input(type="text", name="name", placeholder="Full name", required)
      label Phone
      input(type="text", name="phone", placeholder="e.g. 9876543210", required)
      label Address
      textarea(name="address", placeholder="Optional address")
      div(style="display:flex; gap:12px;")
        button.btn.btn-primary(type="submit") Save Contact
        a.btn(href="/" style="background:#f3f4f6; color:#374151;") Cancel
