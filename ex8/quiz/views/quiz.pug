extends layout
block content
  h2 Quiz
  form(method="POST", action="/submit")
    each q in questions
      p #{q.question}
      input(type="radio", name=q.id, value="1") #{q.option1}
      br
      input(type="radio", name=q.id, value="2") #{q.option2}
      br
      input(type="radio", name=q.id, value="3") #{q.option3}
      br
      input(type="radio", name=q.id, value="4") #{q.option4}
      hr
    button(type="submit") Submit