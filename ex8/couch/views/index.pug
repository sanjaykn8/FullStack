extends layout
block content
  if error
    .alert.alert-error= error

  .card
    h2 📋 Book Ticket
    form(method="POST", action="/book")
      .form-grid
        input(type="text", name="pnr", placeholder="PNR Number", required)
        input(type="text", name="name", placeholder="Passenger Name", required)
        input(type="text", name="source", placeholder="Source Station", required)
        input(type="text", name="dest", placeholder="Destination", required)
        input(type="date", name="date", required)
      br
      button.btn.btn-primary(type="submit") 🎫 Book Ticket

  .card
    h2 ❌ Cancel Ticket
    form(method="POST", action="/cancel")
      .form-grid
        input(type="text", name="pnr", placeholder="PNR Number", required)
      br
      button.btn.btn-danger(type="submit") Cancel Ticket

  .card
    h2 ✏️ Update Destination
    form(method="POST", action="/update")
      .form-grid
        input(type="text", name="pnr", placeholder="PNR Number", required)
        input(type="text", name="dest", placeholder="New Destination", required)
      br
      button.btn.btn-warning(type="submit") Update
