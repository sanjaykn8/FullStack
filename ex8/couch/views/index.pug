extends layout
block content
  h2 Railway Reservation

  h3 Book Ticket
  form(method="POST", action="/book")
    input(type="text", name="pnr", placeholder="PNR", required)
    input(type="text", name="source", placeholder="Source", required)
    input(type="text", name="dest", placeholder="Destination", required)
    input(type="date", name="date", required)
    input(type="text", name="name", placeholder="Name", required)
    button(type="submit") Book

  h3 Cancel Ticket
  form(method="POST", action="/cancel")
    input(type="text", name="pnr", placeholder="PNR")
    button(type="submit") Cancel

  h3 Update Destination
  form(method="POST", action="/update")
    input(type="text", name="pnr", placeholder="PNR")
    input(type="text", name="dest", placeholder="New Destination")
    button(type="submit") Update

  br
  a(href="/chart") View Chart