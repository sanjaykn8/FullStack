doctype html
html
  head
    title Railway Reservation System
    meta(name="viewport", content="width=device-width, initial-scale=1")
    style.
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f4f8; color: #333; min-height: 100vh; }
      header { background: #1a3a5c; color: #fff; padding: 16px 32px; display: flex; align-items: center; gap: 12px; }
      header h1 { font-size: 1.4rem; font-weight: 600; }
      header span { font-size: 1.6rem; }
      nav { background: #fff; border-bottom: 1px solid #dde3ea; padding: 0 32px; display: flex; gap: 0; }
      nav a { display: inline-block; padding: 12px 20px; text-decoration: none; color: #555; font-size: 0.9rem; border-bottom: 3px solid transparent; transition: all .2s; }
      nav a:hover { color: #1a3a5c; border-bottom-color: #1a3a5c; background: #f7f9fc; }
      main { max-width: 860px; margin: 32px auto; padding: 0 20px 40px; }
      .card { background: #fff; border-radius: 10px; box-shadow: 0 1px 6px rgba(0,0,0,.08); padding: 24px 28px; margin-bottom: 24px; }
      .card h2 { font-size: 1.1rem; color: #1a3a5c; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid #eee; }
      .form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }
      input[type="text"], input[type="date"] {
        width: 100%; padding: 9px 12px; border: 1px solid #ccd3dc; border-radius: 6px;
        font-size: 0.9rem; outline: none; transition: border .2s;
      }
      input[type="text"]:focus, input[type="date"]:focus { border-color: #1a3a5c; box-shadow: 0 0 0 3px rgba(26,58,92,.1); }
      input::placeholder { color: #aaa; }
      .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 20px; border: none; border-radius: 6px; cursor: pointer; font-size: 0.9rem; font-weight: 500; transition: all .2s; }
      .btn-primary { background: #1a3a5c; color: #fff; }
      .btn-primary:hover { background: #142d48; }
      .btn-danger { background: #d94040; color: #fff; }
      .btn-danger:hover { background: #b83232; }
      .btn-warning { background: #e07b00; color: #fff; }
      .btn-warning:hover { background: #c06a00; }
      .btn-link { background: transparent; color: #1a3a5c; border: 1px solid #1a3a5c; }
      .btn-link:hover { background: #1a3a5c; color: #fff; }
      .alert { padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem; }
      .alert-error { background: #fde8e8; color: #9b2c2c; border: 1px solid #f5c2c2; }
  body
    header
      span 🚆
      h1 Railway Reservation System
    nav
      a(href="/") Book & Manage
      a(href="/chart") View Chart
    main
      block content
